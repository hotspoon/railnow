package pages

import (
	"fmt"
	templcore "github.com/a-h/templ"
	"github.com/hotspoon/railnow/internal/models"
	"github.com/hotspoon/railnow/templates/components"
	"github.com/hotspoon/railnow/templates/layout"
)

templ Home(stations []models.Station, fromID, toID int64, info models.ScheduleInfo) {
	@layout.Page("Kereta berikutnya", homeContent(stations, fromID, toID, info, false, models.SearchPage{}))
}

templ SearchHome(stations []models.Station, fromID, toID int64, page models.SearchPage) {
	@layout.Page("Jadwal", homeContent(stations, fromID, toID, page.ScheduleInfo, true, page))
}

templ homeContent(stations []models.Station, fromID, toID int64, info models.ScheduleInfo, hasResults bool, page models.SearchPage) {
	<header class="storybook-hero mb-7">
		<div class="hero-brand-row flex items-center justify-between">
			<a href="/" class="text-xl font-black tracking-tight">🚆 RuteKRL</a>
			<span id="live-clock" class="text-sm font-medium text-slate-500"></span>
		</div>
		<h1 class="hero-title mt-7 text-4xl font-black tracking-tight">Cari jadwal <br/><span class="text-blue-600">KRL-mu</span></h1>
		<p class="hero-subtitle mt-2 text-slate-500">Temukan kereta berikutnya tanpa ribet.</p>
	</header>
	@components.SearchForm(stations, fromID, toID, page.SearchTime)
	@scheduleNotice(info, "mt-3")
	if !hasResults {
		<section id="recent-routes" class="mt-5" hidden>
			<h2 class="mb-2 text-sm font-bold text-slate-700 dark:text-slate-200">Pencarian terakhir</h2>
			<div class="flex flex-wrap gap-2"></div>
		</section>
	}
	if hasResults {
		<div class="mt-6">@SearchResult(page)</div>
	} else {
		<section id="schedule-results" class="mt-6"></section>
	}
}

templ scheduleNotice(info models.ScheduleInfo, classes string) {
	<details class={ classes + " schedule-status rounded-2xl border border-slate-200 bg-white/75 px-3 py-2 text-sm" }>
		<summary class="flex min-h-8 cursor-pointer items-center justify-between gap-2 font-semibold">
			if info.Status == "stale" {
				<span class="text-amber-700">⚠ Data mungkin sudah kedaluwarsa</span>
			} else if info.Status == "available" {
				<span class="text-emerald-700">● Data diperbarui { info.UpdatedLabel }</span>
			} else {
				<span class="text-slate-500">○ Status pembaruan belum tersedia</span>
			}
			<span class="status-chevron text-slate-400">⌄</span>
		</summary>
		<div class="schedule-status-details mt-2 border-t border-slate-200 pt-2 text-xs leading-relaxed text-slate-500">
			if info.Stale && info.UpdatedLabel != "" {
				<p>Terakhir diperbarui { info.UpdatedLabel }.</p>
			}
			if info.EffectiveDate != "" {
				<p>Jadwal efektif: { info.EffectiveDate }.</p>
			}
			if info.SourceName != "" {
				if info.SourceURL != "" {
					<p>Sumber: <a class="font-semibold text-blue-600 underline" href={ templcore.SafeURL(info.SourceURL) } target="_blank" rel="noreferrer">{ info.SourceName }</a>.</p>
				} else {
					<p>Sumber: { info.SourceName }.</p>
				}
			}
			<p>Snapshot jadwal terencana, bukan posisi kereta atau informasi keterlambatan real-time.</p>
		</div>
	</details>
}

templ SearchResult(page models.SearchPage) {
	<section id="schedule-results" class="animate-in">
		<div class="route-results-header my-5">
			@components.Route(page.From.Name, page.To.Name)
			@components.FavoriteButton(page.From.ID, page.To.ID, false)
		</div>
		if len(page.Departures) == 0 && len(page.Transfers) == 0 {
			<div class="rounded-3xl bg-white p-6 text-center text-slate-500 shadow-sm"><p class="font-semibold text-slate-700">Belum ada kereta langsung</p><p class="mt-1 text-sm">Coba pilih waktu lain atau rute dengan transit.</p></div>
		} else if len(page.Departures) > 0 {
			@nextCard(page.Departures[0], page.To.Name, page.From.ID, page.To.ID, page.SearchTime)
			<h2 class="mb-3 mt-7 text-lg font-bold">Keberangkatan berikutnya</h2>
			<div class="space-y-3">
				for _, d := range page.Departures[1:min(len(page.Departures), 7)] {
				@trainCard(d, page.From.ID, page.To.ID, page.SearchTime)
				}
			</div>
			if len(page.Departures) > 7 {
				<details class="upcoming-more mt-3">
					<summary>{ fmt.Sprintf("Tampilkan %d keberangkatan lagi", len(page.Departures)-7) }</summary>
					<div class="mt-3 space-y-3">
						for _, d := range page.Departures[7:] {
							@trainCard(d, page.From.ID, page.To.ID, page.SearchTime)
						}
					</div>
				</details>
			}
		}
		if len(page.Transfers) > 0 {
			<h2 class="mb-3 mt-7 text-lg font-bold">Opsi transit</h2>
			for _, trip := range page.Transfers {
				<article class="mb-3 rounded-2xl bg-white p-4 shadow-sm ring-1 ring-slate-200 dark:bg-slate-900 dark:ring-slate-800"><div class="flex items-center justify-between"><strong>{ trip.First.Departure } → { trip.Second.Arrival }</strong><span class="text-sm font-semibold text-slate-500">{ fmt.Sprintf("%d menit", trip.TotalMinutes) }</span></div><div class="mt-4 space-y-3 border-l-2 border-blue-200 pl-4 text-sm"><div><span class="font-bold">{ trip.First.Departure }</span><p class="text-slate-500">Naik KRL tujuan { trainDestination(trip.First.Route) }</p></div><div><span class="font-bold">{ trip.Transfer.Name }</span><p class="text-amber-700">Turun dan pindah · tunggu { fmt.Sprintf("%d menit", trip.WaitMinutes) }</p></div><div><span class="font-bold">{ trip.Second.Departure }</span><p class="text-slate-500">Naik KRL tujuan { trainDestination(trip.Second.Route) }</p></div></div></article>
			}
		}
	</section>
}

templ SearchPage(page models.SearchPage) {
	@layout.Page("Jadwal", SearchResult(page))
}

templ nextCard(d models.Departure, destination string, from, to int64, searchTime string) {
	<a href={ templcore.SafeURL(trainDetailURL(d.TrainID, from, to, searchTime)) } class="next-train-card train-detail-link block rounded-3xl bg-blue-600 p-5 text-white shadow-xl shadow-blue-600/25 transition active:scale-[.99]">
		<div class="flex items-start justify-between"><p class="text-xs font-bold tracking-widest text-blue-100">KERETA BERIKUTNYA</p><span class="rounded-full bg-white/15 px-2 py-1 text-xs">{ dayLabel(d.DayOffset) }</span></div>
		<div class="next-train-primary mt-5 flex items-end justify-between gap-4"><div class="next-train-destination"><time class="departure-time text-5xl font-black tracking-tight" data-clock-time>{ d.Departure }</time><p class="mt-2 text-xs font-bold uppercase tracking-widest text-blue-100">Tujuan kereta</p><h2 class="mt-1 text-2xl font-black">{ trainDestination(d.Route) }</h2></div><div class="next-train-countdown text-right"><p class="text-sm text-blue-100">Berangkat dalam</p><strong class="countdown-time text-2xl" data-countdown={ d.Departure } data-day-offset={ fmt.Sprintf("%d", d.DayOffset) }>--:--</strong></div></div>
		<div class="next-train-footer mt-5 flex items-center justify-between border-t border-white/20 pt-4"><span class="train-route-pill rounded-full bg-white/15 px-2 py-1 text-xs font-bold">Tiba { destination } · { d.Arrival }</span><span class="train-meta text-sm font-bold">KRL { d.Number } · { fmt.Sprintf("%d menit", d.Duration) } ›</span></div>
		if d.DayOffset > 0 {
			<p class="mt-2 text-xs text-blue-100">Layanan berikutnya tersedia { dayLabel(d.DayOffset) }.</p>
		}
	</a>
}

templ trainCard(d models.Departure, from, to int64, searchTime string) {
	<a href={ templcore.SafeURL(trainDetailURL(d.TrainID, from, to, searchTime)) } class="upcoming-train-card train-detail-link flex items-center gap-3 rounded-2xl bg-white p-4 shadow-sm ring-1 ring-slate-200 transition active:scale-[.99] dark:bg-slate-900 dark:ring-slate-800">
		<time class="text-2xl font-black tracking-tight text-slate-900 dark:text-white" data-clock-time>{ d.Departure }</time>
		<div class="train-card-details flex-1"><strong class="block text-sm text-slate-900 dark:text-slate-50">KRL { d.Number } · { dayLabel(d.DayOffset) }</strong><span class={ "compact-train-route line-badge " + lineBadgeClass(d.Route) }>{ d.Route }</span></div>
		<span class="text-sm text-slate-500">{ fmt.Sprintf("%d menit", d.Duration) }</span><span class="text-lg font-bold text-blue-600">›</span>
	</a>
}

templ TrainDetail(stops []models.Stop, info models.ScheduleInfo, backURL string) {
	@layout.Page("Detail kereta", trainContent(stops, info, backURL))
}

templ trainContent(stops []models.Stop, info models.ScheduleInfo, backURL string) {
	<a href={ templcore.SafeURL(backURL) } data-back-results class="text-sm font-bold text-blue-600">‹ Kembali ke hasil</a>
	<h1 class="mt-6 text-3xl font-black">Pemberhentian kereta</h1>
	<p class="mt-1 text-slate-500">Waktu keberangkatan dari setiap stasiun</p>@scheduleNotice(info, "mt-3")
	<div class="mt-7 space-y-0">
		for _, s := range stops {
			<div class="flex gap-4"><div class="flex flex-col items-center"><span class="mt-1 h-3 w-3 rounded-full bg-blue-600"></span><span class="h-12 w-px bg-slate-200"></span></div><div class="flex-1 pb-6"><div class="flex justify-between"><strong>{ s.Name }</strong><time>{ s.Departure }</time></div><p class="mt-1 text-xs text-slate-400">Pemberhentian { fmt.Sprintf("%d", s.Sequence) }</p></div></div>
		}
	</div>
}

templ Saved(info models.ScheduleInfo) {
	@layout.Page("Rute tersimpan", savedContent(info))
}

templ savedContent(info models.ScheduleInfo) {
	<section class="saved-page">
		<div class="flex items-start justify-between gap-3">
			<div><h1 class="text-3xl font-black">Rute tersimpan</h1><p class="mt-1 text-sm text-slate-500">Jadwal berikutnya untuk rute di perangkat ini.</p></div>
			<button id="refresh-saved" type="button" class="saved-refresh rounded-full border border-slate-200 bg-white px-3 py-2 text-sm font-bold text-blue-600">↻ Muat ulang</button>
		</div>
		@scheduleNotice(info, "mt-4")
		<div id="saved-routes" class="mt-5 space-y-3" aria-live="polite">
			<div class="saved-skeleton rounded-2xl bg-white p-4 shadow-sm"><span class="block h-4 w-2/3 rounded bg-slate-200"></span><span class="mt-3 block h-8 w-1/3 rounded bg-slate-200"></span></div>
		</div>
	</section>
}
