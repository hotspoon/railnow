package pages

import (
	"fmt"
	templcore "github.com/a-h/templ"
	"github.com/hotspoon/railnow/internal/models"
	"github.com/hotspoon/railnow/templates/components"
	"github.com/hotspoon/railnow/templates/layout"
)

templ Home(stations []models.Station, fromID, toID int64, info models.ScheduleInfo) {
	@layout.Page("Your next train", homeContent(stations, fromID, toID, info, false, models.SearchPage{}))
}

templ SearchHome(stations []models.Station, fromID, toID int64, page models.SearchPage) {
	@layout.Page("Schedule", homeContent(stations, fromID, toID, page.ScheduleInfo, true, page))
}

templ homeContent(stations []models.Station, fromID, toID int64, info models.ScheduleInfo, hasResults bool, page models.SearchPage) {
	<header class="storybook-hero mb-7">
		<div class="flex items-center justify-between">
			<a href="/" class="text-xl font-black tracking-tight">🚆 RailNow</a>
			<span id="live-clock" class="text-sm font-medium text-slate-500"></span>
		</div>
		<h1 class="mt-7 text-4xl font-black tracking-tight">Cari jadwal <br/><span class="text-blue-600">KRL mu</span></h1>
		<p class="mt-2 text-slate-500">Fast commuter schedules, without the fuss.</p>
	</header>
	@components.SearchForm(stations, fromID, toID)
	@scheduleNotice(info, "mt-3")
	if hasResults {
		<div class="mt-6">@SearchResult(page)</div>
	} else {
		<section id="schedule-results" class="mt-6"></section>
	}
}

templ scheduleNotice(info models.ScheduleInfo, classes string) {
	if info.Stale {
		<p class={ classes + " text-sm font-medium text-amber-700" } role="status">Schedule data may be out of date.</p>
	}
}

templ SearchResult(page models.SearchPage) {
	<section id="schedule-results" class="animate-in">
		<div class="route-results-header mb-7">
			@components.Route(page.From.Name, page.To.Name)
			@components.FavoriteButton(page.From.ID, page.To.ID, false)
		</div>
		if len(page.Departures) == 0 && len(page.Transfers) == 0 {
			<div class="rounded-3xl bg-white p-6 text-center text-slate-500 shadow-sm">No scheduled trains on this route yet.</div>
		} else if len(page.Departures) > 0 {
			@nextCard(page.Departures[0], page.To.Name, page.From.ID, page.To.ID)
			<h2 class="mb-3 mt-7 text-lg font-bold">Upcoming</h2>
			<div class="space-y-3">
				for _, d := range page.Departures[1:] {
				@trainCard(d, page.From.ID, page.To.ID)
				}
			</div>
		}
		if len(page.Transfers) > 0 {
			<h2 class="mb-3 mt-7 text-lg font-bold">Transfer options</h2>
			for _, trip := range page.Transfers {
				<article class="mb-3 rounded-2xl bg-white p-4 shadow-sm ring-1 ring-slate-200 dark:bg-slate-900 dark:ring-slate-800"><strong>{ trip.First.Departure } → { trip.Second.Arrival }</strong><p class="mt-1 text-sm text-slate-500">Change at { trip.Transfer.Name } · { fmt.Sprintf("%d min wait", trip.WaitMinutes) } · { fmt.Sprintf("%d min total", trip.TotalMinutes) }</p><p class="mt-1 text-xs text-slate-400">{ trip.First.Route } → { trip.Second.Route }</p></article>
			}
		}
	</section>
}

templ SearchPage(page models.SearchPage) {
	@layout.Page("Schedule", SearchResult(page))
}

templ nextCard(d models.Departure, destination string, from, to int64) {
	<a href={ templcore.SafeURL(fmt.Sprintf("/train/%d?from=%d&to=%d", d.TrainID, from, to)) } class="train-detail-link block rounded-3xl bg-blue-600 p-5 text-white shadow-xl shadow-blue-600/25 transition active:scale-[.99]">
		<div class="flex items-start justify-between"><p class="text-xs font-bold tracking-widest text-blue-100">NEXT TRAIN</p><span class="rounded-full bg-white/15 px-2 py-1 text-xs">Scheduled</span></div>
		<div class="mt-5 flex items-end justify-between gap-4"><div><time class="text-5xl font-black tracking-tight">{ d.Departure }</time><p class="mt-2 text-xs font-bold uppercase tracking-widest text-blue-100">Destination</p><h2 class="mt-1 text-2xl font-black">{ destination }</h2></div><div class="text-right"><p class="text-sm text-blue-100">Leaves in</p><strong class="text-2xl" data-countdown={ d.Departure } data-next-day={ fmt.Sprintf("%t", d.NextDay) }>--:--</strong></div></div>
		<div class="mt-5 flex items-center justify-between border-t border-white/20 pt-4"><span class="rounded-full bg-white/15 px-2 py-1 text-xs font-bold">{ d.Route }</span><span class="text-sm font-bold">Train { d.Number } · { fmt.Sprintf("%d min", d.Duration) } ›</span></div>
		if d.NextDay {
			<p class="mt-2 text-xs text-blue-100">First available service tomorrow</p>
		}
	</a>
}

templ trainCard(d models.Departure, from, to int64) {
	<a href={ templcore.SafeURL(fmt.Sprintf("/train/%d?from=%d&to=%d", d.TrainID, from, to)) } class="train-detail-link flex items-center gap-3 rounded-2xl bg-white p-4 shadow-sm ring-1 ring-slate-200 transition active:scale-[.99] dark:bg-slate-900 dark:ring-slate-800">
		<time class="text-2xl font-black tracking-tight text-slate-900 dark:text-white">{ d.Departure }</time>
		<div class="flex-1"><strong class="block text-sm text-slate-900 dark:text-slate-50">Train { d.Number }</strong><span class={ "compact-train-route line-badge " + lineBadgeClass(d.Route) }>{ d.Route }</span></div>
		<span class="text-sm text-slate-500">{ fmt.Sprintf("%d min", d.Duration) }</span><span class="text-lg font-bold text-blue-600">›</span>
	</a>
}

templ TrainDetail(stops []models.Stop, info models.ScheduleInfo, backURL string) {
	@layout.Page("Train details", trainContent(stops, info, backURL))
}

templ trainContent(stops []models.Stop, info models.ScheduleInfo, backURL string) {
	<a href={ templcore.SafeURL(backURL) } data-back-results class="text-sm font-bold text-blue-600">‹ Back to results</a>
	<h1 class="mt-6 text-3xl font-black">Train stops</h1>
	<p class="mt-1 text-slate-500">Waktu keberangkatan dari setiap stasiun</p>@scheduleNotice(info, "mt-3")
	<div class="mt-7 space-y-0">
		for _, s := range stops {
			<div class="flex gap-4"><div class="flex flex-col items-center"><span class="mt-1 h-3 w-3 rounded-full bg-blue-600"></span><span class="h-12 w-px bg-slate-200"></span></div><div class="flex-1 pb-6"><div class="flex justify-between"><strong>{ s.Name }</strong><time>{ s.Departure }</time></div><p class="mt-1 text-xs text-slate-400">Stop { fmt.Sprintf("%d", s.Sequence) }</p></div></div>
		}
	</div>
}

templ Saved() {
	@layout.Page("Saved routes", savedContent())
}

templ savedContent() { <section><h1 class="text-3xl font-black">Saved routes</h1><p class="mt-2 text-slate-500">Routes saved on this device.</p><div id="saved-routes" class="mt-6 space-y-3"></div></section> }
