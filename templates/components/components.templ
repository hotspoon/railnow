package components

import (
	"fmt"
	"github.com/hotspoon/railnow/internal/models"
)

templ SearchForm(stations []models.Station, fromID, toID int64) {
	<form class="storybook-select-card rounded-3xl bg-white p-4 shadow-sm ring-1 ring-slate-200 dark:bg-slate-900 dark:ring-slate-800" hx-get="/search" hx-target="#schedule-results" hx-swap="outerHTML" hx-indicator="#search-loading" hx-push-url="true">
		<label class="block text-xs font-bold uppercase tracking-widest text-slate-400">From</label>
		<button type="button" id="from-trigger" class="station-trigger mt-1 w-full py-2 text-left text-lg font-semibold" data-target="from">Select station</button>
		<input id="from" name="from" type="hidden" value={ fmt.Sprintf("%d", fromID) }/>
		<div id="from-options" class="station-options mt-1 rounded-xl border border-slate-200 bg-white p-2 shadow-lg dark:bg-slate-900 dark:ring-slate-800" role="listbox" hidden>
			<input id="from-query" class="station-query w-full rounded-lg bg-slate-50 px-3 py-2 text-sm outline-none dark:bg-slate-800" autocomplete="off" placeholder="Search station" data-target="from"/>
			<div class="station-option-list mt-1">
				for _, s := range stations {
					<button type="button" role="option" data-station-id={ fmt.Sprintf("%d", s.ID) } data-station-name={ s.Name }>{ s.Name } <span>{ s.Code }</span></button>
				}
			</div>
		</div>
		<div class="my-1 border-t border-dashed border-slate-200"></div>
		<div class="flex items-center justify-between"><label class="block text-xs font-bold uppercase tracking-widest text-slate-400">To</label><button type="button" id="swap-route" class="text-sm font-bold text-blue-600">Swap</button></div>
		<button type="button" id="to-trigger" class="station-trigger mt-1 w-full py-2 text-left text-lg font-semibold" data-target="to">Select station</button>
		<input id="to" name="to" type="hidden" value={ fmt.Sprintf("%d", toID) }/>
		<div id="to-options" class="station-options mt-1 rounded-xl border border-slate-200 bg-white p-2 shadow-lg dark:bg-slate-900 dark:ring-slate-800" role="listbox" hidden>
			<input id="to-query" class="station-query w-full rounded-lg bg-slate-50 px-3 py-2 text-sm outline-none dark:bg-slate-800" autocomplete="off" placeholder="Search station" data-target="to"/>
			<div class="station-option-list mt-1">
				for _, s := range stations {
					<button type="button" role="option" data-station-id={ fmt.Sprintf("%d", s.ID) } data-station-name={ s.Name }>{ s.Name } <span>{ s.Code }</span></button>
				}
			</div>
		</div>
		<button id="search-submit" class="mt-4 w-full rounded-2xl bg-blue-600 py-3.5 font-bold text-white shadow-lg shadow-blue-600/25 active:scale-[.98]" data-label="Find next train">Find next train</button>
		// <div id="search-loading" class="htmx-indicator mt-3 text-center text-sm text-slate-400" role="status">Finding trains…</div>
	</form>
}

templ DestinationSelect(stations []models.Station, selected int64) {
	<select id="to-station" name="to" class="mt-1 w-full bg-transparent py-2 text-lg font-semibold outline-none">
		for _, s := range stations {
			<option value={ fmt.Sprintf("%d", s.ID) } selected?={ s.ID == selected }>{ s.Name }</option>
		}
	</select>
}

templ Route(from, to string) {
	<div class="flex items-center gap-3 text-sm font-semibold"><span>{ from }</span><span class="text-blue-600">↓</span><span>{ to }</span></div>
}

templ FavoriteButton(from, to int64, active bool) {
	<button type="button" class="save-route rounded-full border px-3 py-1.5 text-sm font-semibold" data-from={ fmt.Sprintf("%d", from) } data-to={ fmt.Sprintf("%d", to) } aria-label="Toggle saved route">☆ Save route</button>
}
